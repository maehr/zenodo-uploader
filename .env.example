# Copy this file to .env (git-ignored) and fill in your tokens.
# Create tokens at https://zenodo.org/account/settings/applications/tokens/new/
# with scopes: deposit:write and deposit:actions.

ZENODO_TOKEN=            # zenodo.org (production)
ZENODO_SANDBOX_TOKEN=    # sandbox.zenodo.org (separate account and token)

# MCP server only. Set to 1 to permit irreversible publishing on zenodo.org.
# Leave it unset to restrict the server to drafts and to the sandbox.
# ZENODO_ALLOW_PRODUCTION_PUBLISH=1
